{
  "format": 1,
  "enrollment": [
    {
      "path": "config",
      "autosave": true,
      "encrypt": false,
      "variants": []
    },
    {
      "path": "home/.ssh/config.d",
      "autosave": true,
      "encrypt": false,
      "variants": []
    },
    {
      "path": "home/.ssh/config.d/linux-bw-identity-agent",
      "autosave": true,
      "encrypt": false,
      "variants": [
        {
          "os": [
            "linux"
          ],
          "profile": null,
          "default": false
        }
      ]
    },
    {
      "path": "home/.ssh/config.d/macos-bw-identity-agent",
      "autosave": true,
      "encrypt": false,
      "variants": [
        {
          "os": [
            "macos"
          ],
          "profile": null,
          "default": false
        }
      ]
    }
  ],
  "exclude": [
    ".idea",
    "__pycache__",
    ".DS_Store"
  ],
  "recipients": [],
  "permissions": {
    "config/conf.d": 509,
    "config/tasks": 509,
    "config/tasks/maintenance": 509,
    "config/tasks/presets": 509,
    "home/.ssh": 448,
    "home/.ssh/config.d/hosts": 436,
    "home/.ssh/config.d/settings": 436
  }
}